# Variables de entorno de ms-usuarios.
# Este archivo es solo un ejemplo: NO escribir valores reales aqui.
# Ejemplo de DB_URL: jdbc:mysql://localhost:3306/bd_usuarios?createDatabaseIfNotExist=true
DB_URL=
DB_USER=
DB_PASSWORD=
# Clave para firmar los tokens (HS256). Texto UTF-8 de MINIMO 32 caracteres, no Base64.
# Debe ser la misma en ms-usuarios, ms-salas y ms-reservas.
JWT_SECRET=
# Duracion del token en MINUTOS. Ejemplo: 480 = 8 horas.
JWT_EXPIRATION=
# Contrasena de los usuarios de prueba del dataset. Se comparte por fuera del repo.
PASSWORD_PRUEBA=
