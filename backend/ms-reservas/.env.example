# Variables de entorno de ms-reservas.
# Este archivo es solo un ejemplo: NO escribir valores reales aqui.
# Ejemplo de DB_URL: jdbc:mysql://localhost:3306/bd_reservas?createDatabaseIfNotExist=true
DB_URL=
DB_USER=
DB_PASSWORD=
# Clave para validar los tokens (HS256). Texto UTF-8 de MINIMO 32 caracteres, no Base64.
# Debe ser la misma en ms-usuarios, ms-salas y ms-reservas.
JWT_SECRET=
# Origenes de la web permitidos por CORS. Ejemplo: http://localhost:5173
CORS_ORIGINS=
# URL de ms-salas para verificar que las salas existan y esten activas.
MS_SALAS_URL=http://localhost:8082
